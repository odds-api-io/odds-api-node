{
  "name": "odds-api-io",
  "version": "1.5.3",
  "description": "Official Node.js and TypeScript SDK for the Odds-API.io sports betting odds API: real-time odds API for 450+ bookmakers, REST and WebSocket",
  "keywords": [
    "odds api",
    "sports odds api",
    "betting odds api",
    "odds",
    "sports betting",
    "betting odds",
    "sportsbook",
    "player props",
    "live odds",
    "odds feed",
    "arbitrage",
    "value bets",
    "websocket",
    "typescript",
    "nfl",
    "nba",
    "mlb",
    "nhl",
    "soccer",
    "football",
    "tennis",
    "esports",
    "bet365",
    "draftkings",
    "fanduel",
    "betfair",
    "outrights",
    "golf odds",
    "closing lines",
    "bet settlement"
  ],
  "author": "Odds-API.io",
  "license": "MIT",
  "homepage": "https://github.com/odds-api-io/odds-api-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/odds-api-io/odds-api-node.git"
  },
  "bugs": {
    "url": "https://github.com/odds-api-io/odds-api-node/issues"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:types && node scripts/write-module-types.mjs",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:types": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "ws": ">=8.0.0"
  },
  "peerDependenciesMeta": {
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
